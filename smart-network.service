[Unit]
Description=Smart Network Failover Hotspot (Raspberry Pi OS / NetworkManager)
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=/bin/bash /opt/smart-network/smart-network.sh
Restart=on-failure
RestartSec=5s
EnvironmentFile=-/etc/default/smart-network

[Install]
WantedBy=multi-user.target
